# Keep the deploy upload to just the app surface. Without this, `vercel deploy`
# from a dev machine tries to upload node_modules/ (~142MB) + playwright-report/
# (~73MB) and aborts. The git-integration deploy clones only committed files, so
# this mainly protects local CLI deploys.
#
# IMPORTANT: do NOT add a broad `*.png` here — icons/*.png are PWA assets the
# manifest needs at runtime. Only exclude non-app directories and dev artifacts.
node_modules
test-results
playwright-report
.playwright-mcp
_audit
_archive
.planning
tests
.git
.github
.claude
.cursor
dogfood-output-*.png
